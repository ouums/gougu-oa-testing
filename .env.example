# 复制为 .env 后填写；.env 不会被提交
# 真实环境变量优先于本文件

# ---- 被测系统 ----
OA_BASE_URL=http://localhost:8080
OA_WSL_DISTRO=Ubuntu

# OA 在 WSL 中的安装目录（session、runtime、备份都在这下面）
OA_HOME=/home/oa

# ---- 数据库 ----
OA_DB_NAME=oa60
OA_DB_USER=root
OA_DB_PASSWORD=

# ---- 路径（一般不用改；留空时按 OA_HOME 推导）----
# OA_SESSION_DIR=/home/oa/office/runtime/session
# OA_SESSION_DIR_WIN=\\wsl.localhost\Ubuntu\home\oa\office\runtime\session
# OA_BACKUP_DIR=/home/oa

# ---- 账号 ----
OA_ADMIN_USER=admin
OA_ADMIN_PWD=
OA_USER_PWD=

# 可选：按账号单独覆盖
# OA_FENGCAILING_PWD=
# OA_YUCINXIN_PWD=
# OA_QINJIAXIAN_PWD=
# OA_TESTMIN_PWD=
# OA_TESTEMP_PWD=
# OA_TESTSTAFF_PWD=
